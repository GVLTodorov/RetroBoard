<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- RetroBoard.Client (needed for BoardHubClientTests.cs) comes in transitively through
         RetroBoard.Api's own ProjectReference. A direct reference here would pull in the Blazor
         WebAssembly SDK's browser-wasm variant of Microsoft.AspNetCore.SignalR.Client alongside the
         plain netcoreapp one from the PackageReference below, and the compiler would then bind
         IHubConnectionBuilder extension methods against two different assemblies. -->
    <ProjectReference Include="..\RetroBoard.Api\RetroBoard.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
